<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.newsfeedmanagementsystem.controller.AdminPanelController"
      styleClass="root-pane">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="← Back to Feed" onAction="#onBackClicked" styleClass="button-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Admin Dashboard &amp; Moderation" styleClass="nav-title"/>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="User Management">
            <VBox spacing="12">
                <padding>
                    <Insets top="12" right="8" bottom="8" left="8"/>
                </padding>
                <TableView fx:id="userTableView" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="usernameCol" text="Username" prefWidth="140"/>
                        <TableColumn fx:id="displayNameCol" text="Display Name" prefWidth="180"/>
                        <TableColumn fx:id="roleCol" text="Role" prefWidth="120"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="actionsCol" text="Actions" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Article Moderation">
            <VBox spacing="12">
                <padding>
                    <Insets top="12" right="8" bottom="8" left="8"/>
                </padding>
                <HBox spacing="12">
                    <CheckBox fx:id="showReportedOnlyCheckBox" text="Show only reported articles" />
                </HBox>
                <ListView fx:id="articleListView" VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>