<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.newsfeedmanagementsystem.controller.LoginController"
           styleClass="root-pane"
           prefWidth="900" prefHeight="600">

    <HBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT">
        <padding>
            <Insets top="16" right="16" />
        </padding>
        <ToggleButton fx:id="darkModeToggle" text="🌙" styleClass="theme-toggle-btn"
                      onAction="#onDarkModeToggleClicked"/>
    </HBox>

    <VBox alignment="CENTER"  maxWidth="380" maxHeight="520" styleClass="auth-card">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="NewsFeed" styleClass="brand-title"/>
        <Label text="Stay informed. Stay connected." styleClass="brand-subtitle">
            <VBox.margin>
                <Insets bottom="28"/>
            </VBox.margin>
        </Label>

        <VBox spacing="6">
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="input-field"/>
        </VBox>

        <VBox spacing="6" fx:id="displayNameContainer" managed="false" visible="false">
            <VBox.margin>
                <Insets top="14"/>
            </VBox.margin>
            <Label text="Display Name" styleClass="field-label"/>
            <TextField fx:id="displayNameField" promptText="Enter your display name" styleClass="input-field"/>
        </VBox>

        <VBox spacing="6">
            <VBox.margin>
                <Insets top="14"/>
            </VBox.margin>
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field"/>
        </VBox>

        <VBox spacing="6" fx:id="confirmPasswordContainer" managed="false" visible="false">
            <VBox.margin>
                <Insets top="14"/>
            </VBox.margin>
            <Label text="Confirm Password" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" styleClass="input-field"/>
        </VBox>

        <Button fx:id="submitButton" text="Login" styleClass="primary-btn" maxWidth="Infinity"
                onAction="#onSubmitClicked">
            <VBox.margin>
                <Insets top="24"/>
            </VBox.margin>
        </Button>

        <Hyperlink fx:id="toggleModeLink" text="Don't have an account? Register" styleClass="toggle-link"
                   onAction="#onToggleModeClicked">
            <VBox.margin>
                <Insets top="12"/>
            </VBox.margin>
        </Hyperlink>
    </VBox>
</StackPane>
