<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.ToggleButton?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.newsfeedmanagementsystem.controller.ProfileController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="700">

    <!-- TOP NAVIGATION -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-nav">
            <Hyperlink text="← Back to Feed" styleClass="nav-link" onAction="#onBackClicked"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="headerLabel" text="User Profile" styleClass="nav-title"/>
            <ToggleButton fx:id="darkModeToggle" text="🌙" styleClass="theme-toggle-btn"
                          onAction="#onDarkModeToggleClicked"/>
        </HBox>
    </top>

    <center>
        <HBox alignment="TOP_CENTER" spacing="24">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="16" prefWidth="360" maxWidth="400">
                <VBox spacing="10" styleClass="card">
                    <Label fx:id="displayNameLabel" styleClass="brand-title"/>
                    <Label fx:id="usernameLabel" styleClass="article-meta"/>
                    <Label fx:id="roleTag" styleClass="tag-chip"/>
                    <Label fx:id="statusLabel" styleClass="error-label" visible="false" managed="false"/>
                </VBox>

                <VBox fx:id="settingsContainer" spacing="14" styleClass="card">
                    <Label text="Account Settings" styleClass="field-label"/>

                    <VBox spacing="6">
                        <Label text="Display Name" styleClass="field-label"/>
                        <HBox spacing="8">
                            <TextField fx:id="editDisplayNameField" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                            <Button text="Save" styleClass="primary-btn" onAction="#onUpdateDisplayNameClicked"/>
                        </HBox>
                    </VBox>

                    <!-- Change Password -->
                    <VBox spacing="6">
                        <Label text="Old Password" styleClass="field-label"/>
                        <PasswordField fx:id="oldPasswordField" styleClass="input-field"/>

                        <Label text="New Password" styleClass="field-label"/>
                        <PasswordField fx:id="newPasswordField" styleClass="input-field"/>

                        <Button text="Change Password" styleClass="primary-btn" maxWidth="Infinity"
                                onAction="#onChangePasswordClicked">
                            <VBox.margin>
                                <Insets top="6"/>
                            </VBox.margin>
                        </Button>
                    </VBox>
                </VBox>
            </VBox>

            <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="580">
                <TabPane fx:id="profileTabPane" tabClosingPolicy="UNAVAILABLE">
                    <Tab text="Published Articles">
                        <VBox spacing="12">
                            <padding>
                                <Insets top="12" right="8" bottom="8" left="8"/>
                            </padding>
                            <ListView fx:id="userArticlesListView" styleClass="list-view" VBox.vgrow="ALWAYS"/>
                            <Label fx:id="emptyUserArticlesLabel" text="You haven't published any articles yet."
                                   styleClass="placeholder-label" visible="false" managed="false"
                                   alignment="CENTER" textAlignment="CENTER"
                                   maxWidth="Infinity" prefHeight="100"/>
                        </VBox>
                    </Tab>
                    <Tab text="Bookmarks">
                        <VBox spacing="12">
                            <padding>
                                <Insets top="12" right="8" bottom="8" left="8"/>
                            </padding>
                            <ListView fx:id="bookmarksListView" styleClass="list-view" VBox.vgrow="ALWAYS"/>
                            <Label fx:id="emptyBookmarksLabel" text="You haven't bookmarked any articles."
                                   styleClass="placeholder-label" visible="false" managed="false"
                                   alignment="CENTER" textAlignment="CENTER"
                                   maxWidth="Infinity" prefHeight="100"/>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>