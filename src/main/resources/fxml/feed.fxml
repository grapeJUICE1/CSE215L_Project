<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.newsfeedmanagementsystem.controller.FeedController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="700">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-nav">
                <Label text="NewsFeed" styleClass="nav-title"/>

                <TextField fx:id="searchField" promptText="Search articles..." styleClass="input-field"
                           prefWidth="260" onAction="#onSearchChanged"/>

                <ComboBox fx:id="categoryFilterBox" promptText="Category" styleClass="input-field"
                          onAction="#onFilterChanged"/>

                <ComboBox fx:id="sortModeBox" promptText="Sort by" styleClass="input-field"
                          onAction="#onSortChanged"/>

                <ComboBox fx:id="typeFilterBox" promptText="Type" styleClass="input-field"
                          onAction="#onFilterChanged"/>
                <Button text="Reset Filters" styleClass="button-secondary" onAction="#onResetFiltersClicked"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="publishButton" text="+ Publish" styleClass="primary-btn"
                        onAction="#onPublishClicked"/>

                <Hyperlink fx:id="profileLink" text="Profile" styleClass="nav-link" onAction="#onProfileClicked"/>
                <Hyperlink fx:id="adminLink" text="Admin" styleClass="nav-link" onAction="#onAdminClicked"/>
                <Hyperlink text="Logout" styleClass="nav-link" onAction="#onLogoutClicked"/>

                <ToggleButton fx:id="darkModeToggle" text="🌙" styleClass="theme-toggle-btn"
                              onAction="#onDarkModeToggleClicked"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="0">
            <ListView fx:id="articleListView" styleClass="list-view" VBox.vgrow="ALWAYS"/>
            <Label fx:id="emptyFeedLabel" text="No articles found. Try adjusting your filters."
                   styleClass="placeholder-label" visible="false" managed="false"
                   alignment="CENTER" textAlignment="CENTER"
                   maxWidth="Infinity" prefHeight="100"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="16">
            <padding>
                <Insets top="14" right="0" bottom="18" left="0"/>
            </padding>
            <Button fx:id="prevPageButton" text="← Prev" styleClass="nav-link" onAction="#onPrevPageClicked"/>
            <Label fx:id="pageLabel" text="Page 1" styleClass="article-meta"/>
            <Button fx:id="nextPageButton" text="Next →" styleClass="nav-link" onAction="#onNextPageClicked"/>
        </HBox>
    </bottom>
</BorderPane>
