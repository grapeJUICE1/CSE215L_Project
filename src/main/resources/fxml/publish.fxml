<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.newsfeedmanagementsystem.controller.PublishController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="700">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-nav">
            <Hyperlink text="← Back to Feed" styleClass="nav-link" onAction="#onBackClicked"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Publish Article" styleClass="nav-title"/>
        </HBox>
    </top>

    <center>
        <HBox alignment="TOP_CENTER">
            <VBox spacing="14" maxWidth="600" styleClass="card">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

                <VBox spacing="6">
                    <Label text="Title" styleClass="field-label"/>
                    <TextField fx:id="titleField" promptText="Article title" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Category" styleClass="field-label"/>
                    <ComboBox fx:id="categoryBox" editable="true" maxWidth="Infinity"
                              promptText="e.g. Weather, Politics, Sports" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Article Type" styleClass="field-label"/>
                    <ComboBox fx:id="typeBox" maxWidth="Infinity" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Content" styleClass="field-label"/>
                    <TextArea fx:id="contentField" promptText="Write your article..." styleClass="input-field"
                              wrapText="true" prefRowCount="10"/>
                </VBox>

                <Button text="Publish" styleClass="primary-btn" maxWidth="Infinity" onAction="#onPublishClicked">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Button>
            </VBox>
        </HBox>
    </center>
</BorderPane>
