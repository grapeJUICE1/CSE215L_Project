<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.newsfeedmanagementsystem.controller.ArticleDetailController"
            styleClass="root-pane"
            prefWidth="1000" prefHeight="700">

    <!-- ===== TOP NAV ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-nav">
            <Hyperlink text="← Back to Feed" styleClass="nav-link" onAction="#onBackClicked"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="editButton" text="Edit" styleClass="nav-link" onAction="#onEditClicked"/>
            <Button fx:id="changeTypeButton" text="Change Type" styleClass="nav-link"/>
            <Button fx:id="bookmarkButton" text="Bookmark" styleClass="nav-link" onAction="#onBookmarkClicked"/>
            <Button fx:id="deleteButton" text="Delete" styleClass="nav-link" onAction="#onDeleteClicked"/>
            <Button fx:id="reportButton" text="Report" styleClass="nav-link" onAction="#onReportClicked"/>
        </HBox>
    </top>

    <!-- ===== ARTICLE + COMMENTS (scrollable) ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <HBox alignment="TOP_CENTER">
                <VBox spacing="20" maxWidth="700">
                    <padding>
                        <Insets top="30" right="30" bottom="30" left="30"/>
                    </padding>

                    <!-- Article content -->
                    <VBox spacing="10" styleClass="card">
                        <Label fx:id="categoryTag" styleClass="tag-chip"/>
                        <Label fx:id="titleLabel" styleClass="article-title" wrapText="true"/>
                        <Label fx:id="metaLabel" styleClass="article-meta"/>
                        <Label fx:id="contentLabel" styleClass="article-body" wrapText="true">
                            <VBox.margin>
                                <Insets top="10"/>
                            </VBox.margin>
                        </Label>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox.margin>
                                <Insets top="10"/>
                            </VBox.margin>
                            <Button fx:id="likeButton" text="🤍 Like" styleClass="nav-link" onAction="#onLikeClicked"/>
                            <Label fx:id="likeCountLabel" styleClass="article-meta"/>
                        </HBox>
                    </VBox>

                    <!-- New comment box -->
                    <VBox spacing="8" styleClass="card">
                        <Label text="Add a comment" styleClass="field-label"/>
                        <TextArea fx:id="newCommentField" promptText="Write a comment..." styleClass="input-field"
                                  wrapText="true" prefRowCount="2"/>
                        <Button text="Post Comment" styleClass="primary-btn" maxWidth="Infinity"
                                onAction="#onPostCommentClicked"/>
                    </VBox>

                    <!-- Comments list -->
                    <Label text="Comments" styleClass="field-label"/>
                    <VBox fx:id="commentsContainer" spacing="12"/>

                </VBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
